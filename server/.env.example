# Server Configuration
PORT=8080
NODE_ENV=development # or production

# Frontend URL (used for CORS — comma-separated list of allowed origins)
FRONTEND_URL=http://localhost:3000,http://localhost:8081

# Deployment mode
# - serverless: no Redis, no workers. Queueable work (email, sms, whatsapp,
#   e-invoice, PDF, payment links) runs inline; scheduled/heavy features
#   (recurring invoices, stock alerts, payment reminders, large reports) are gated
#   behind longRunningOnlyProcedure. This is the ONLY mode that boots today, and
#   the one production runs.
# - long-running: Redis-backed BullMQ queues plus a separate worker process.
#   The server REFUSES TO START in this mode until that worker exists: every queue
#   is defined and none is consumed, so accepted work would silently never run
#   (see server/index.ts and docs/DEPLOYMENT.md). Do not select it yet.
DEPLOYMENT_MODE=serverless

# Auth Secrets (Generate strong random secrets for production!)
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ACCESS_TOKEN_SECRET=your-access-token-secret

# Token Expiry (Optional - defaults shown)
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Database
DATABASE_URL=postgresql://postgres:1234567890@localhost:5432/seed

# Test Database: a THROWAWAY database, never your dev one. The integration suites
# create and delete rows in it. Apply the migrations to it once before testing:
#   DATABASE_URL=<this url> pnpm --filter @seed/database db:deploy
TEST_DATABASE_URL=postgresql://postgres:1234567890@localhost:5432/seed_test

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Comma-separated OAuth client IDs used by the mobile app (Android, iOS).
# The server's googleSignInMobile handler validates ID-token audiences against
# GOOGLE_CLIENT_ID plus every ID listed here.
GOOGLE_MOBILE_CLIENT_IDS=your-android-client-id,your-ios-client-id

# Email Configuration
# EMAIL_PROVIDER selects the sending backend: smtp (default) or resend
EMAIL_PROVIDER=smtp

# SMTP (used when EMAIL_PROVIDER=smtp — e.g. AWS SES via SMTP)
SMTP_USERNAME=xxxxx
SMTP_PASSWORD=xxxxx
SMTP_PORT=587
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_MAIL=example@yourdomain.com

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_MAIL=no-reply@yourdomain.com

# SMS (optional). SMS_PROVIDER: msg91 (default) or twilio. With no credentials the
# feature is disabled and the UI says so; nothing is queued that cannot be sent.
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=xxxxxxxx
# MSG91_SENDER_ID=SEEDAP
# TWILIO_ACCOUNT_SID=ACxxxxxxxx        # also used by WhatsApp when it runs on Twilio
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+10000000000      # SMS sender when SMS_PROVIDER=twilio

# WhatsApp (optional). WHATSAPP_PROVIDER: twilio (default) or gupshup.
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_FROM=whatsapp:+10000000000  # Twilio sender
# GUPSHUP_API_KEY=xxxxxxxx             # when WHATSAPP_PROVIDER=gupshup
# GUPSHUP_SRC_NAME=xxxxxxxx

# E-invoicing and e-way bills via a GST Suvidha Provider (optional).
# Leave all of these commented out until you have GSP credentials: without them
# invoices cannot be registered with the IRP and the UI disables the action.
# Go-live steps: docs/EINVOICE_GO_LIVE.md
# GSP_BASE_URL=https://...             # defaults to the NIC sandbox when omitted
# GSP_CLIENT_ID=xxxxxxxx
# GSP_CLIENT_SECRET=xxxxxxxx
# GSP_USERNAME=xxxxxxxx
# GSP_PASSWORD=xxxxxxxx
# GSP_GSTIN=27AAAAA0000A1Z5            # exactly 15 characters

# Razorpay payment links (optional).
# RAZORPAY_WEBHOOK_SECRET is REQUIRED as soon as either key is set: the server
# refuses to boot otherwise, because a paid link could never be reconciled.
# Register <public server url>/webhooks/razorpay in the Razorpay dashboard.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Optional Test Configuration
TEST_MAIL=test@example.com
TEST_OTP=123456

# AWS Credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Redis (required by @seed/jobs for BullMQ queues)
# Required only when DEPLOYMENT_MODE=long-running. Omit in serverless mode.
# Local dev: docker run -d --name redis-seed -p 6379:6379 redis:7-alpine
# Production: Upstash, Redis Cloud, or AWS ElastiCache
REDIS_URL=redis://localhost:6379
