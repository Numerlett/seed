# Point this at the backend. On a physical device (Expo Go) you MUST use the
# host machine's LAN IP, not localhost — the phone cannot reach the host's localhost.
# Find it with `ipconfig` (Windows) and use the IPv4 address, e.g.:
EXPO_PUBLIC_SERVER_BASE_URL=http://192.168.1.10:8080

# --- Google sign-in (optional) ---
# Per-platform OAuth client IDs from Google Cloud Console. The "Continue with
# Google" button only appears when at least one is set. Native Google sign-in
# needs a development build (it does not work reliably in Expo Go).
# Add the same IDs to the server's GOOGLE_MOBILE_CLIENT_IDS so token audiences match.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
